# Database (compose provides MySQL; local default is MySQL on localhost).
# For Render Postgres use:
# DB_URL=jdbc:postgresql://<host>:5432/<db>?sslmode=require
# DB_DRIVER=org.postgresql.Driver
# DB_DIALECT=org.hibernate.dialect.PostgreSQLDialect
DB_URL=jdbc:mysql://localhost:3306/astrotalk?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=astrotalk
DB_PASS=change-me
DB_DRIVER=com.mysql.cj.jdbc.Driver
DB_DIALECT=org.hibernate.dialect.MySQLDialect

# JWT (all required - no defaults; secret must be >= 32 bytes, Base64-encoded)
JWT_SECRET=change-me-to-a-base64-encoded-32-byte-secret
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Razorpay (required for payments)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Google sign-in (optional - leave unset to run without it; the /api/auth/google
# endpoint then returns a clear error)
GOOGLE_CLIENT_ID=

# Allowed CORS / WebSocket origins, comma-separated
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:3000
