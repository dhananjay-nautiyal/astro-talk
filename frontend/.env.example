# Copy to .env and fill in real values. Never commit .env.
# API base URL (same-origin /api proxy in dev by default).
# For native APK builds bake in the absolute backend URL, e.g.
# VITE_API_URL=https://astro-talk-lnx5.onrender.com/api
VITE_API_URL=http://localhost:8080/api
# WebSocket endpoint (same-origin /ws in dev). Native builds need the
# absolute URL, e.g. VITE_WS_URL=https://astro-talk-lnx5.onrender.com/ws
VITE_WS_URL=/ws
# Direct APK link for landing-page store buttons
VITE_APP_DOWNLOAD_URL=https://github.com/dhani748/astro-talk/releases/latest
# Google OAuth client ID (required for Google sign-in button)
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# Razorpay key ID (required for wallet top-up checkout)
VITE_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
